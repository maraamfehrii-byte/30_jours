Jours\TrenteJours\app\src\main\res\drawable\salade_caprese.jpg" qualifiers="" type="drawable"/><file name="salade_fruits" path="C:\Users\fehri\Downloads\TrenteJours\TrenteJours\app\src\main\res\drawable\salade_fruits.jpg" qualifiers="" type="drawable"/><file name="soupe_lentilles" path="C:\Users\fehri\Downloads\TrenteJours\TrenteJours\app\src\main\res\drawable\soupe_lentilles.jpg" qualifiers="" type="drawable"/><file name="soupe_potiron" path="C:\Users\fehri\Downloads\TrenteJours\TrenteJours\app\src\main\res\drawable\soupe_potiron.jpg" qualifiers="" type="drawable"/><file name="taboule" path="C:\Users\fehri\Downloads\TrenteJours\TrenteJours\app\src\main\res\drawable\taboule.jpg" qualifiers="" type="drawable"/><file name="tarte_pommes" path="C:\Users\fehri\Downloads\TrenteJours\TrenteJours\app\src\main\res\drawable\tarte_pommes.jpg" qualifiers="" type="drawable"/><file name="wok_legumes" path="C:\Users\fehri\Downloads\TrenteJours\TrenteJours\app\src\main\res\drawable\wok_legumes.jpg" qualifiers="" type="drawable"/><file name="poppins_bold" path="C:\Users\fehri\Downloads\TrenteJours\TrenteJours\app\src\main\res\font\poppins_bold.ttf" qualifiers="" type="font"/><file name="poppins_regular" path="C:\Users\fehri\Downloads\TrenteJours\TrenteJours\app\src\main\res\font\poppins_regular.ttf" qualifiers="" type="font"/><file path="C:\Users\fehri\Downloads\TrenteJours\TrenteJours\app\src\main\res\values\strings.xml" qualifiers=""><string name="app_name">30 jours de recettes</string><string name="day_label">Jour %1$d</string><string name="tip1_title">Crêpes</string><string name="tip1_desc">Mélange 250 g de farine, 3 œufs, 50 cl de lait et une pincée de sel. Laisse reposer 30 minutes, puis cuis chaque crêpe 1 à 2 minutes par face dans une poêle chaude.</string><string name="tip2_title">Omelette aux herbes</string><string name="tip2_desc">Bats 3 œufs avec du sel, du poivre et des herbes ciselées. Verse dans une poêle beurrée et cuis à feu moyen en ramenant les bords vers le centre.</string><string name="tip3_title">Soupe de lentilles</string><string name="tip3_desc">Fais revenir un oignon et une carotte, ajoute 200 g de lentilles corail et 1 litre d\'eau. Cuis 20 minutes, assaisonne avec du cumin, puis mixe.</string><string name="tip4_title">Salade caprese</string><string name="tip4_desc">Alterne tranches de tomate et de mozzarella, ajoute des feuilles de basilic, un filet d\'huile d\'olive, du sel et du poivre.</string><string name="tip5_title">Pâtes à la tomate</string><string name="tip5_desc">Fais dorer de l\'ail dans l\'huile d\'olive, ajoute des tomates concassées et laisse mijoter 15 minutes. Mélange avec des pâtes cuites al dente.</string><string name="tip6_title">Houmous</string><string name="tip6_desc">Mixe 400 g de pois chiches égouttés avec le jus d\'un citron, 2 cuillères de tahini, une gousse d\'ail, de l\'huile d\'olive et un peu d\'eau.</string><string name="tip7_title">Ratatouille</string><string name="tip7_desc">Coupe aubergine, courgette, poivron et tomates en dés. Fais-les revenir avec de l\'oignon et de l\'ail, puis laisse mijoter 40 minutes à couvert.</string><string name="tip8_title">Poulet rôti</string><string name="tip8_desc">Badigeonne un poulet de beurre, sel, poivre et thym. Enfourne à 200 °C pendant environ 1 h 15, en l\'arrosant de son jus.</string><string name="tip9_title">Quiche lorraine</string><string name="tip9_desc">Étale une pâte brisée, ajoute des lardons, puis un mélange de 3 œufs, 20 cl de crème et 20 cl de lait. Cuis 35 minutes à 180 °C.</string><string name="tip10_title">Couscous aux légumes</string><string name="tip10_desc">Fais cuire carottes, courgettes, navets et pois chiches dans un bouillon épicé. Sers sur de la semoule gonflée à l\'eau chaude et au beurre.</string><string name="tip11_title">Gratin dauphinois</string><string name="tip11_desc">Dispose des pommes de terre en fines tranches dans un plat frotté d\'ail. Couvre de crème et de lait, puis cuis 1 heure à 170 °C.</string><string name="tip12_title">Risotto aux champignons</string><string name="tip12_desc">Fais revenir riz arborio et champignons, puis ajoute du bouillon chaud louche par louche pendant 18 minutes. Termine avec du parmesan.</string><string name="tip13_title">Chakchouka</string><string name="tip13_desc">Fais mijoter oignon, poivron, tomates et épices (cumin, paprika, harissa). Creuse des puits, casse les œufs dedans et cuis à couvert 5 minutes.</string><string name="tip14_title">Pancakes</string><string name="tip14_desc">Mélange 200 g de farine, 1 sachet de levure, 2 œufs, 25 cl de lait et du sucre. Cuis des petites louches dans une poêle jusqu\'à l\'apparition de bulles.</string><string name="tip15_title">Guacamole</string><string name="tip15_desc">Écrase 2 avocats mûrs avec du jus de citron vert, de l\'oignon rouge, de la coriandre, du sel et un peu de piment.</string><string name="tip16_title">Soupe de potiron</string><string name="tip16_desc">Fais cuire 800 g de potiron et une pomme de terre dans un bouillon pendant 25 minutes. Mixe avec une cuillère de crème.</string><string name="tip17_title">Curry de pois chiches</string><string name="tip17_desc">Fais revenir oignon, ail et gingembre avec du curry, ajoute des tomates, 400 g de pois chiches et du lait de coco. Laisse mijoter 15 minutes.</string><string name="tip18_title">Wok de légumes</string><string name="tip18_desc">Coupe les légumes en lanières et fais-les sauter à feu vif avec de l\'huile et de l\'ail. Ajoute de la sauce soja au dernier moment.</string><string name="tip19_title">Poisson en papillote</string><string name="tip19_desc">Place un filet de poisson sur du papier cuisson avec citron, herbes, un filet d\'huile et du sel. Ferme et cuis 15 minutes à 180 °C.</string><string name="tip20_title">Tarte aux pommes</string><string name="tip20_desc">Garnis une pâte brisée de fines tranches de pommes, saupoudre de sucre et dépose quelques noisettes de beurre. Cuis 35 minutes à 180 °C.</string><string name="tip21_title">Mousse au chocolat</string><string name="tip21_desc">Fais fondre 200 g de chocolat noir, incorpore 6 jaunes d\'œufs, puis 6 blancs montés en neige. Laisse prendre 4 heures au frais.</string><string name="tip22_title">Gâteau au yaourt</string><string name="tip22_desc">Utilise le pot de yaourt comme mesure : 1 yaourt, 2 pots de sucre, 3 pots de farine, 3 œufs, 1/2 pot d\'huile et 1 sachet de levure. Cuis 35 minutes à 180 °C.</string><string name="tip23_title">Pain perdu</string><string name="tip23_desc">Trempe des tranches de pain rassis dans un mélange d\'œufs et de lait sucré, puis fais-les dorer au beurre dans une poêle.</string><string name="tip24_title">Taboulé</string><string name="tip24_desc">Mélange de la semoule fine gonflée avec beaucoup de persil et de menthe ciselés, des tomates, de l\'oignon, du citron et de l\'huile d\'olive.</string><string name="tip25_title">Pizza maison</string><string name="tip25_desc">Pétris 300 g de farine, 20 cl d\'eau tiède, de la levure et du sel. Laisse lever 1 heure, garnis et cuis 12 minutes à 240 °C.</string><string name="tip26_title">Lasagnes</string><string name="tip26_desc">Alterne feuilles de pâte, sauce bolognaise et béchamel, puis termine par du fromage râpé. Cuis 40 minutes à 180 °C.</string><string name="tip27_title">Brik au thon</string><string name="tip27_desc">Dépose thon, persil, câpres et un œuf sur une feuille de brik, replie en triangle et fais frire quelques minutes de chaque côté.</string><string name="tip28_title">Salade de fruits</string><string name="tip28_desc">Coupe des fruits de saison en dés, arrose de jus d\'orange et de citron, ajoute un peu de sucre ou de miel et laisse macérer 30 minutes.</string><string name="tip29_title">Cookies</string><string name="tip29_desc">Mélange 100 g de beurre mou, 100 g de sucre, 1 œuf, 150 g de farine et des pépites de chocolat. Cuis 10 minutes à 180 °C.</string><string name="tip30_title">Crème caramel</string><string name="tip30_desc">Verse du caramel au fond des moules, puis une préparation de 4 œufs, 50 cl de lait et du sucre. Cuis 40 minutes au bain-marie à 160 °C.</string></file><file path="C:\Users\fehri\Downloads\TrenteJours\TrenteJours\app\src\main\res\values\themes.xml" qualifiers=""><style name="Theme.Trentejours" parent="android:Theme.Material.Light.NoActionBar"/></file><file name="curry_pois_chiches" path="C:\Users\fehri\Downloads\TrenteJours\TrenteJours\app\src\main\res\drawable\curry_pois_chiches.jpg" qualifiers="" type="drawable"/></source></dataSet><dataSet aapt-namespace="http://schemas.android.com/apk/res-auto" config="debug$Generated" generated="true" ignore_pattern="!.svn:!.git:!.ds_store:!*.scc:.*:&lt;dir>_*:!CVS:!thumbs.db:!picasa.ini:!*~"><source path="C:\Users\fehri\Downloads\TrenteJours\TrenteJours\app\src\debug\res"/></dataSet><dataSet aapt-namespace="http://schemas.android.com/apk/res-auto" config="debug" generated-set="debug$Generated" ignore_pattern="!.svn:!.git:!.ds_store:!*.scc:.*:&lt;dir>_*:!CVS:!thumbs.db:!picasa.ini:!*~"><source path="C:\Users\fehri\Downloads\TrenteJours\TrenteJours\app\src\debug\res"/></dataSet><dataSet aapt-namespace="http://schemas.android.com/apk/res-auto" config="generated$Generated" generated="true" ignore_pattern="!.svn:!.git:!.ds_store:!*.scc:.*:&lt;dir>_*:!CVS:!thumbs.db:!picasa.ini:!*~"><source path="C:\Users\fehri\Downloads\TrenteJours\TrenteJours\app\build\generated\res\resValues\debug"/></dataSet><dataSet aapt-namespace="http://schemas.android.com/apk/res-auto" config="generated" generated-set="generated$Generated" ignore_pattern="!.svn:!.git:!.ds_store:!*.scc:.*:&lt;dir>_*:!CVS:!thumbs.db:!picasa.ini:!*~"><source path="C:\Users\fehri\Downloads\TrenteJours\TrenteJours\app\build\generated\res\resValues\debug"/></dataSet><mergedItems/></merger>